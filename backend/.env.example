# Default mock mode: no external model request. Keep actual secrets in backend/.env only.
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_NAME=
MODEL_ENDPOINT=
# Reuse the inspected Expedia Lite OpenRouter settings when opting into live mode:
# MODEL_PROVIDER=live
# MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free
# MODEL_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# MODEL_API_KEY=<your private OpenRouter key; never commit a real value>
# Finite total deadline: 1–25 seconds; default 4, verified live configuration uses 25.
MODEL_TIMEOUT_SECONDS=25
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Voice bootstrap uses a separate OpenAI key, not the OpenRouter text key.
# Configured means key present, not verified provider access.
OPENAI_API_KEY=
# Voice models/settings are fixed in backend/app/voice_session.json.
# Server-owned UI duration (1–300 seconds); not a provider-side time cap.
VOICE_SESSION_DURATION_SECONDS=60
# Finite creation deadline (0.1–25 seconds); no automatic retries.
VOICE_PROVIDER_TIMEOUT_SECONDS=10

# Optional local development diagnostics: fixed stage/status/category only; default off.
# VOICE_DIAGNOSTICS=1

# Isolated diagnostic only (full Pause keeps its exact voice_session.json).
VOICE_LIVE_MODEL=gpt-live-1
